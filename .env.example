# ============================================================
# FILE: .env.example
# PROJECT: IDora – Smart Campus ID Portal
# ============================================================
#
# NOTE: IDora runs immediately in Zero-Configuration DEMO MODE
# if these environment variables are left blank or omitted.
#
# To connect to a live Supabase project:
# 1. Create a free project at https://supabase.com
# 2. Run the SQL script from `supabase/schema.sql` in the SQL Editor
# 3. Copy your Project URL and Anon Public Key below
# 4. Rename this file to `.env` or `.env.local`
# ============================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here
