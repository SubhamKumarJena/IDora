# IDora browser configuration
# Real Supabase authentication is the default. Missing values display an
# actionable configuration error; they NEVER activate demo mode automatically.
# Set BOTH variables in Vercel > Project > Settings > Environment Variables
# for EACH target environment: Preview and Production.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-public-key

# Optional, for an explicitly isolated demo build ONLY:
# Set VITE_ENABLE_DEMO_MODE=true and REMOVE both VITE_SUPABASE_* values
# from that build. Do not use this flag on real Preview or Production builds.
# VITE_ENABLE_DEMO_MODE=true

# Never use a service_role or secret key in any VITE_ variable.
